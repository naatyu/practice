{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug a module",
            "type": "debugpy",
            "request": "launch",
            "module": "${input:pythonModule}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Debug current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-q", "-s"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "pythonModule",
            "type": "promptString",
            "description": "Module to debug (e.g. moe.packed_experts, no .py)",
            "default": "moe.packed_experts"
        }
    ]
}
